# Copiar a .env y rellenar localmente. Nunca commitear .env

# Appwrite (cliente)
VITE_APPWRITE_ENDPOINT=
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=
VITE_APPWRITE_STORAGE_BUCKET_ID=
VITE_APPWRITE_USERS_FUNCTION=

# Google (opcional)
VITE_GOOGLE_CLIENT_ID=
# Opcional. El flujo MVP actual no necesita Worker para Google.
VITE_GOOGLE_AUTH_URL=

# Servicios auxiliares (URLs públicas de workers/servicios; sin API keys de servidor)
VITE_PASSWORD_RESET_URL=
VITE_INFRA_STATUS_URL=
VITE_APPWRITE_CONSOLE_URL=
VITE_RENDER_CONSOLE_URL=
VITE_CLOUDFLARE_CONSOLE_URL=

# Alset Pulse (support inbox) — preferir key de solo lectura / acotada
VITE_ALSET_PULSE_BASE_URL=
VITE_ALSET_PULSE_API_KEY=
VITE_ALSET_PULSE_SUPPORT_MESSAGES_PATH=/support/messages

# Pusher (support realtime) — solo key pública de cliente, nunca secret
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=
VITE_PUSHER_SUPPORT_CHANNEL=support-inbox

# NO poner en el frontend:
# - APPWRITE_API_KEY (server)
# - VITE_PUSHER_SECRETS / PUSHER_SECRET
# - RENDER_API_KEY
# - GMAIL_APP_PASSWORD
# Esas viven en Cloudflare Workers / Render / Appwrite Functions.
