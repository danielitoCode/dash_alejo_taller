# Copiar a .env y rellenar localmente. Nunca commitear .env

# ——— Fase 1 Auth0 (SPA dash) ———
# Application: type SPA · Token Endpoint Auth Method: none
# Callback / Logout / Web Origins en Auth0 Dashboard:
#   http://localhost:5173/
VITE_AUTH_PROVIDER=auth0
VITE_AUTH0_DOMAIN=dev-4wg25aeppqw5z8z3.us.auth0.com
VITE_AUTH0_CLIENT_ID=W0nfqURzGXAT6QRTYb3TbZqYI7fY3my2
# Opcional: API identifier si usas access tokens a API propia
VITE_AUTH0_AUDIENCE=
# Deben coincidir con Auth0 Application (por defecto = origin :5173)
VITE_AUTH0_REDIRECT_URI=http://localhost:5173
VITE_AUTH0_LOGOUT_RETURN_TO=http://localhost:5173

# Appwrite (cliente) — data/files hasta fases 2–3
VITE_APPWRITE_ENDPOINT=
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=
VITE_APPWRITE_STORAGE_BUCKET_ID=
VITE_APPWRITE_USERS_FUNCTION=

# Google (opcional / legacy Appwrite)
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_AUTH_URL=

# Servicios auxiliares
VITE_PASSWORD_RESET_URL=
VITE_INFRA_STATUS_URL=
VITE_APPWRITE_CONSOLE_URL=
VITE_RENDER_CONSOLE_URL=
VITE_CLOUDFLARE_CONSOLE_URL=

# Alset Pulse
VITE_ALSET_PULSE_BASE_URL=
VITE_ALSET_PULSE_API_KEY=
VITE_ALSET_PULSE_SUPPORT_MESSAGES_PATH=/support/messages

# Pusher (solo key pública)
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=
VITE_PUSHER_SUPPORT_CHANNEL=support-inbox

# NO poner en el frontend:
# - AUTH0_CLIENT_SECRET
# - APPWRITE_API_KEY
# - PUSHER_SECRET
